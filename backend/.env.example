# Backend Environment Variables
APP_NAME="ALLEVIA Environment Simulator"
APP_ENV=development
DEBUG=true
PORT=8000
HOST=0.0.0.0

# Security & CORS
ALLOWED_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]
SIMULATOR_SECRET=local-dev-simulator-secret-key-32-chars-min

# Session Settings
SESSION_TTL_MINUTES=60
DEFAULT_DEVICE_ID=ALLEVIA-SIM-001

# Source Identifier (Must always be simulated)
TELEMETRY_SOURCE=simulated
