{
  "system": {
    "name": "ALLEVIA Detector Box",
    "microcontroller": "Arduino Uno Rev3 (ATmega328P)",
    "adc_resolution_bits": 10,
    "adc_max_value": 1023,
    "v_ref_volts": 5.0,
    "sampling_rate_hz": 2.0
  },
  "sensors": [
    {
      "id": "bme280",
      "name": "BME280 Environmental Sensor",
      "type": "I2C_DIGITAL",
      "pins": ["SDA/A4", "SCL/A5"],
      "channels": [
        { "name": "temperature", "unit": "°C", "min": -40.0, "max": 85.0, "nominal": 24.0 },
        { "name": "humidity", "unit": "%RH", "min": 0.0, "max": 100.0, "nominal": 48.0 },
        { "name": "pressure", "unit": "hPa", "min": 300.0, "max": 1100.0, "nominal": 1013.25 }
      ]
    },
    {
      "id": "mq2",
      "name": "MQ-2 Flammable Gas & Smoke Sensor",
      "type": "ANALOG_MOS",
      "pins": ["A0"],
      "adc_channel": 0,
      "channels": [
        { "name": "smoke_combustible", "unit": "ADC (10-bit)", "min": 0, "max": 1023, "nominal": 125 }
      ]
    },
    {
      "id": "mq7",
      "name": "MQ-7 Carbon Monoxide Sensor",
      "type": "ANALOG_MOS",
      "pins": ["A1"],
      "adc_channel": 1,
      "channels": [
        { "name": "carbon_monoxide", "unit": "ADC (10-bit)", "min": 0, "max": 1023, "nominal": 95 }
      ]
    },
    {
      "id": "mq135",
      "name": "MQ-135 Air Quality Sensor",
      "type": "ANALOG_MOS",
      "pins": ["A2"],
      "adc_channel": 2,
      "channels": [
        { "name": "air_quality", "unit": "ADC (10-bit)", "min": 0, "max": 1023, "nominal": 150 }
      ]
    },
    {
      "id": "ir",
      "name": "IR Obstacle / Beam Interrupter",
      "type": "DIGITAL_FLAG",
      "pins": ["D2"],
      "digital_channel": 2,
      "channels": [
        { "name": "beam_broken", "unit": "boolean", "min": 0, "max": 1, "nominal": 0 }
      ]
    }
  ]
}
