# Root Environment Configuration (Local Development & Production)

# Environment Mode: 'development' or 'production' (in production, remote ingest URL and device key are strictly required)
APP_ENV=development

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_BASE_URL=ws://localhost:8000

# Backend Configuration
PORT=8000
HOST=0.0.0.0
DEBUG=true
ALLOWED_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]
SIMULATOR_SECRET=local-dev-simulator-secret-key-32-chars-min
SESSION_TTL_MINUTES=60
DEFAULT_DEVICE_ID=ALLEVIA-SIM-001
TELEMETRY_SOURCE=simulated

# Scheduler Protected Tick Token (Required for POST /internal/tick)
TICK_TOKEN=local-dev-tick-token-change-in-production

# Main Allevia Backend Ingestion Configuration
# (In development defaults to http://localhost:8000; in production, must be your actual remote backend URL)
POPULATION_API_BASE_URL=http://localhost:8000
POPULATION_DEVICE_KEY=Ms5C-o-MDq3OUJfa10nr_k1ANiqcnU3oME5uNVVAAMk
SIMULATOR_INTERVAL_S=60

# Real Backend Integration (Phase 10 Target - Leave Blank in Phases 0-9)
ALLEVIA_API_BASE_URL=
ALLEVIA_WS_BASE_URL=
ALLEVIA_DEVICE_KEY=
ALLEVIA_DEMO_DEVICE_ID=
